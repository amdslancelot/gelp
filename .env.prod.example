# Prod app config. Copy to .env.prod on the server (gitignored) and fill in real
# values. deploy/deploy.sh turns this into the `gelp-env` Kubernetes Secret via
# `kubectl create secret --from-env-file`, so real passwords live ONLY in this
# file — never in a committed or duplicated YAML.

# Auth.js session/JWT signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-openssl-rand-base64-32

# Google OAuth client (from the Google Cloud console) — the prod project's.
AUTH_GOOGLE_ID=replace-with-google-oauth-client-id
AUTH_GOOGLE_SECRET=replace-with-google-oauth-client-secret

# Public URL of the deployed app; must match your GELP_HOST.
AUTH_URL=https://gelp.lans-h.cc
AUTH_TRUST_HOST=true

# Comma-separated allowlist of Google emails permitted to sign in.
ALLOWED_EMAILS=

# Shared Postgres in the `data` namespace (owned by snoopy_home). The gelp_rw
# password must match what scripts/provision-db.sh set on the prod cluster.
# No sslmode/TLS by design: DB traffic stays inside the k3s cluster (a trusted
# network), so plaintext is a deliberate call, not a gap — see the platform repo.
DATABASE_URL=postgres://gelp_rw:replace-with-prod-gelp-rw-password@postgres.data.svc:5432/gelp

# Server-side Google Places API (New) key. Imports work unenriched if empty.
GOOGLE_MAPS_API_KEY=replace-with-google-maps-api-key

# Bearer token the nightly import CronJob presents. Generate: openssl rand -hex 32
CRON_SECRET=replace-with-openssl-rand-hex-32

# Base64 Google service-account JSON for the nightly Drive import (optional).
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=replace-with-base64-service-account-json
DRIVE_FOLDER_ID=replace-with-drive-folder-id

# Key that encrypts each user's stored Drive refresh token (base64, 32 bytes).
# Generate with `openssl rand -base64 32`.
#
# It is not rotatable in place: change it and every stored token becomes
# unreadable, so every user has to reconnect Drive. Losing it is the same event.
# The nightly sync treats an unreadable token as "this user must reconnect" and
# carries on with everyone else, so a rotation degrades rather than breaks.
DRIVE_TOKEN_KEY=replace-me-with-openssl-rand-base64-32

# Browser API key for the Google Picker, used on the settings page to let a user
# hand over one Drive folder. Public by design (it ships to the browser), so
# restrict it in the Google console to the Picker API and to this app's own
# hosts — that restriction is the only thing protecting it.
NEXT_PUBLIC_GOOGLE_PICKER_KEY=AIza-example-picker-browser-key

# The Cloud project's *number* (not its id) — visible on the console dashboard,
# and in any Google API error that names the project. The Picker needs it to
# grant this app access to the file a user picks; without it the pick appears to
# work and every read of that file answers 404.
NEXT_PUBLIC_GOOGLE_PROJECT_NUMBER=000000000000
