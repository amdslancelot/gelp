# Copy this file to terraform.tfvars and fill in real values.
# `cp terraform.tfvars.example terraform.tfvars`
# terraform.tfvars is (and should stay) gitignored, since it holds secrets.

# --- OCI API authentication -------------------------------------------------
# See https://docs.oracle.com/en-us/iaas/Content/API/Concepts/apisigningkey.htm
tenancy_ocid     = "ocid1.tenancy.oc1..aaaaaaaaexampletenancyfakevalue0000000000" # OCID of your tenancy
user_ocid        = "ocid1.user.oc1..aaaaaaaaexampleuserfakevalue00000000000000"  # OCID of the API user
fingerprint      = "12:34:56:78:9a:bc:de:f0:12:34:56:78:9a:bc:de:f0"             # Fingerprint of the uploaded API key
private_key_path = "~/.oci/oci_api_key.pem"                                     # Path to the matching PEM private key
region           = "us-ashburn-1"                                               # OCI region to deploy into

# --- Placement ---------------------------------------------------------------
compartment_ocid    = "ocid1.compartment.oc1..aaaaaaaaexamplecompartmentfake00" # OCID of the target compartment
availability_domain = ""                                                       # Leave blank to auto-pick the first AD

# --- SSH access ----------------------------------------------------------------
ssh_authorized_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExampleFakeKeyDoNotUse you@example.com" # Your public SSH key

# --- Application / deploy configuration ---------------------------------------
repo_url          = "https://github.com/you/gelp.git" # GitHub repo to clone to /opt/gelp
gelp_host         = "gelp.example.com"                 # Public DNS name the app will be served under
letsencrypt_email = "you@example.com"                  # Email for Let's Encrypt/cert-manager notices
webhook_secret    = "changeme-generate-a-long-random-string" # Shared secret for the GitHub push webhook

# --- Instance shape (Always Free A1.Flex defaults) ------------------------------
instance_shape     = "VM.Standard.A1.Flex" # Always-free ARM flexible shape
instance_ocpus     = 4                     # Max free OCPUs for A1.Flex
instance_memory_gb = 24                    # Max free memory (GB) for A1.Flex
