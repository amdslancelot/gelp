# NextAuth secret used to sign session JWTs. Generate with `openssl rand -base64 32`.
AUTH_SECRET=replace-me-with-a-random-32-byte-string

# Google OAuth client credentials (from the Google Cloud console).
AUTH_GOOGLE_ID=000000000000-example.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=GOCSPX-example-oauth-client-secret

# Canonical URL of the app; NextAuth uses it to build callback URLs.
AUTH_URL=http://localhost:3000
# Trust the host header behind a reverse proxy / container.
AUTH_TRUST_HOST=true

# Comma-separated allowlist of Google emails permitted to sign in.
# Leave empty or unset to allow any Google account.
ALLOWED_EMAILS=

# Mobile debug mode (dev only). Google OAuth can't target a bare LAN IP, so set
# this to a user's email to skip login and browse as that user — a phone on the
# LAN can then reach http://<your-mac-ip>:3000 over plain http to test the
# responsive UI. Honored ONLY when NODE_ENV != production, so it is inert in any
# deployment. Leave unset for normal Google login.
# MOBILE_DEBUG_LOGIN=you@example.com

# PostgreSQL connection string. Dev has no database of its own: `npm run db:up`
# opens a port-forward to the shared staging Postgres inside minikube (namespace
# `data`, owned by the snoopy_home repo), so localhost:5432 IS the staging
# server. The gelp_rw password is set once when gelp is provisioned on that
# server (see README §3); in-cluster the same role connects via
# postgres://gelp_rw:<pw>@postgres.data.svc:5432/gelp.
# No sslmode/TLS by design: the port-forward tunnels to localhost and in-cluster
# traffic stays inside minikube/k3s — plaintext is deliberate, not a gap.
DATABASE_URL=postgres://gelp_rw:replace-with-staging-gelp-rw-password@localhost:5432/gelp

# Server-side Google Places API (New) key used to enrich imported places.
# If unset, imports still work but places stay unenriched (no coordinates).
GOOGLE_MAPS_API_KEY=AIza-example-places-api-key

# Bearer token required by the nightly Drive import cron route.
CRON_SECRET=replace-me-with-a-random-cron-token

# Base64-encoded Google service-account JSON used to read the Drive folder.
# Produce with `base64 -i service-account.json`.
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50In0=

# Google Drive folder ID where Takeout zips are uploaded.
DRIVE_FOLDER_ID=0AExampleDriveFolderId

# Key that encrypts each user's stored Drive refresh token (base64, 32 bytes).
# Generate with `openssl rand -base64 32`.
#
# It is not rotatable in place: change it and every stored token becomes
# unreadable, so every user has to reconnect Drive. Losing it is the same event.
# The nightly sync treats an unreadable token as "this user must reconnect" and
# carries on with everyone else, so a rotation degrades rather than breaks.
DRIVE_TOKEN_KEY=replace-me-with-openssl-rand-base64-32

# Browser API key for the Google Picker, used on the settings page to let a user
# hand over one Drive folder. Public by design (it ships to the browser), so
# restrict it in the Google console to the Picker API and to this app's own
# hosts — that restriction is the only thing protecting it.
NEXT_PUBLIC_GOOGLE_PICKER_KEY=AIza-example-picker-browser-key
