# Dependencies
node_modules

# Next.js build output
.next
out

# Local runtime data
data/

# Environment variables (real secrets); keep the documented example
.env*
!.env.example

# Server-side deploy config written by deploy/setup-server.sh into the
# checkout root; never tracked, so git pulls on the server can't clobber it
deploy.env

# Test fixtures generated by scripts/selfcheck.ts
test/fixtures/*.zip

# TypeScript build info / generated types
*.tsbuildinfo
next-env.d.ts

# Editor / OS cruft
.DS_Store
.vscode/
.idea/

# Local working notes
worklog.md

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
