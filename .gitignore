# Dependencies
node_modules

# Next.js build output
.next
out

# Local runtime data
data/

# Environment variables (real secrets) live only in gitignored .env files, one
# per environment (.env, .env.prod). The k8s Secret is created from them at
# deploy time — never a committed YAML. Keep the documented *.example templates.
.env*
!.env*.example

# Server-side deploy config written by deploy/setup-server.sh into the
# checkout root; never tracked, so git pulls on the server can't clobber it
deploy.env

# Test fixtures generated by scripts/selfcheck.ts
test/fixtures/*.zip

# TypeScript build info / generated types
*.tsbuildinfo
next-env.d.ts

# Editor / OS cruft
.DS_Store
.vscode/
.idea/

# Local working notes
worklog.md

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor swap files
*.swp

# Upward-mobility tooling state (generated token logs / hook state)
.upward/

# Stray scratch output
result.json

# Python bytecode from scripts/
__pycache__/
